type PatientProfile = record {
    owner: principal;
    name: text;
    blood_type: text;
    allergies: text;
    authorized_researchers: vec principal;
    created_at: nat64;
};

service : {
    "create_profile": (text, text, text) -> (text);
    "get_my_profile": () -> (opt PatientProfile) query;
    "grant_access": (principal) -> (text);
    "revoke_access": (principal) -> (text);
}